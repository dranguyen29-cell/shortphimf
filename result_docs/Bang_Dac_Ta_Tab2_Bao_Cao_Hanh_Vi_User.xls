<style>
  body {
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 10.5pt;
    color: #1e293b;
  }
  table {
    border-collapse: collapse;
    table-layout: fixed;
    width: 100%;
  }
  th {
    background-color: #1e3a8a;
    color: #ffffff;
    font-weight: bold;
    text-align: center;
    vertical-align: middle;
    border: 0.5pt solid #0f172a;
    padding: 10px 8px;
    font-size: 10.5pt;
    height: 42px;
  }
  .section-header {
    background-color: #0f172a;
    color: #38bdf8;
    font-weight: bold;
    font-size: 11pt;
    padding: 10px 14px;
    border: 0.5pt solid #0284c7;
  }
  td {
    border: 0.5pt solid #cbd5e1;
    padding: 10px 12px;
    vertical-align: top;
    font-size: 10pt;
    white-space: pre-wrap;
    word-wrap: break-word;
    line-height: 1.5;
  }
  .center {
    text-align: center;
    vertical-align: middle;
  }
  .bold {
    font-weight: bold;
  }
  .row-odd {
    background-color: #ffffff;
  }
  .row-even {
    background-color: #f8fafc;
  }
  .color-green {
    color: #16a34a;
    font-weight: bold;
  }
  .color-blue {
    color: #2563eb;
    font-weight: bold;
  }
  .color-purple {
    color: #7c3aed;
    font-weight: bold;
  }
  .badge-ui {
    display: inline-block;
    padding: 3px 8px;
    background-color: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    font-family: Consolas, monospace;
    font-size: 9.5pt;
  }
